{
  "$schema": "https://raw.githubusercontent.com/Azure/Azure-Landing-Zones-Library/main/schemas/default_policy_values.json",
  "defaults": [
    {
      "default_name": "allowed_locations",
      "description": "The locations resources can be deployed to.",
      "policy_assignments": [
        {
          "parameter_names": [
            "listOfAllowedLocations"
          ],
          "policy_assignment_name": "Deny-Resource-Locations"
        }
      ]
    },
    {
      "default_name": "private_link_dns_zone_subscription_id",
      "description": "The subscription of the central private DNS zones (ESLZ/connectivity).",
      "policy_assignments": [
        {
          "parameter_names": [
            "dnsZoneSubscriptionId"
          ],
          "policy_assignment_name": "Deploy-PrivateLink-DNS"
        }
      ]
    },
    {
      "default_name": "private_link_dns_zone_resource_group_name",
      "description": "The resource group of the central private DNS zones (ESLZ/connectivity).",
      "policy_assignments": [
        {
          "parameter_names": [
            "dnsZoneResourceGroupName"
          ],
          "policy_assignment_name": "Deploy-PrivateLink-DNS"
        }
      ]
    }
  ]
}
