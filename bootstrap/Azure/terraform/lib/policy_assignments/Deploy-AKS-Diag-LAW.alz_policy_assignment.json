{
  "type": "Microsoft.Authorization/policyAssignments",
  "apiVersion": "2024-04-01",
  "name": "Deploy-AKS-Diag-LAW",
  "location": "${default_location}",
  "dependsOn": [],
  "identity": {
    "type": "SystemAssigned"
  },
  "properties": {
    "description": "Deploys diagnostic settings on AKS clusters to send their control-plane logs to the central Log Analytics workspace. kube-audit-admin is used instead of kube-audit (it leaves out get and list requests), and metrics are off, to keep ingestion small.",
    "displayName": "Configure diagnostic settings for AKS to the central Log Analytics workspace",
    "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/6c66c325-74c8-42fd-a286-a74b0e2939d8",
    "definitionVersion": "3.*.*",
    "enforcementMode": "Default",
    "nonComplianceMessages": [
      {
        "message": "AKS clusters {enforcementMode} send their control-plane logs to the central Log Analytics workspace."
      }
    ],
    "parameters": {
      "effect": {
        "value": "DeployIfNotExists"
      },
      "logAnalytics": {
        "value": "/subscriptions/00000000-0000-0000-0000-000000000000/resourcegroups/placeholder/providers/Microsoft.OperationalInsights/workspaces/placeholder-la"
      },
      "AllMetrics": {
        "value": "False"
      },
      "kube-apiserver": {
        "value": "True"
      },
      "kube-audit": {
        "value": "False"
      },
      "kube-audit-admin": {
        "value": "True"
      },
      "kube-controller-manager": {
        "value": "False"
      },
      "kube-scheduler": {
        "value": "False"
      },
      "cluster-autoscaler": {
        "value": "True"
      },
      "guard": {
        "value": "True"
      },
      "cloud-controller-manager": {
        "value": "False"
      },
      "csi-azuredisk-controller": {
        "value": "False"
      },
      "csi-azurefile-controller": {
        "value": "False"
      },
      "csi-snapshot-controller": {
        "value": "False"
      }
    },
    "scope": "/providers/Microsoft.Management/managementGroups/placeholder",
    "notScopes": []
  }
}
